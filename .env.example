# pol-core — local/dev environment template. Copy to .env and fill LOCAL values only.
# NEVER put a real secret here. .env is gitignored; only this .env.example is committed.

# --- Database (SQL Server 2025, local) ---
# ASP.NET reads these via ConnectionStrings:Producer / ConnectionStrings:Admin.
ConnectionStrings__Producer=Server=localhost;Database=pol_core_producer;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__Admin=Server=localhost;Database=pol_core_admin;Trusted_Connection=True;TrustServerCertificate=True

# Design-time connection string used by `dotnet ef migrations` (ProducerDbContextFactory / AdminDbContextFactory).
POL_DESIGN_SQL=Server=localhost;Database=pol_core_design;Trusted_Connection=True;TrustServerCertificate=True

# --- Vault master key (PLAN #14) ---
# 32-byte AES key, base64-encoded. DEV/LOCAL custody ONLY — stands in for the external KMS/HSM.
# The placeholder below is base64 of 32 ZERO bytes (a FAKE key). Generate a real local key with:
#   head -c 32 /dev/urandom | base64
Vault__MasterKeyBase64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Google SSO (PLAN #5) — distinct OAuth client per console ---
# Tenant console audience:
Google__ClientId=REPLACE_WITH_TENANT_CONSOLE_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# (The Admin console uses its own Google:ClientId in its appsettings — a SEPARATE OAuth client.)
# Optional hosted-domain ("hd") guard — leave empty to disable.
Google__HostedDomain=

# --- Dev tenant fallback (TenantConsole only) ---
# Used when no verified tenant_id claim is present in Development. Remove outside dev.
Tenant__DevTenantId=00000000-0000-0000-0000-000000000001
