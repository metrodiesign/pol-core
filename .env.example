# pol-core — local/dev environment template. Copy to .env and fill LOCAL values only.
# NEVER put a real secret here. .env is gitignored; only this .env.example is committed.

# --- SQL Server 2025 container (docker-compose) ---
MSSQL_SA_PASSWORD=REPLACE_WITH_LOCAL_SA_PASSWORD
POL_SQL_SERVER=localhost,11433
POL_DB=VCentralPay

# --- DB principal passwords (created by docker/bootstrap/01-principals.sql) ---
# Strong, and must NOT contain the login name (SQL Server password policy). Placeholders only here.
POL_APP_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
POL_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
POL_WORKER_PASSWORD=REPLACE_WITH_LOCAL_WORKER_PASSWORD

# --- Runtime connection strings (one login per host; password from the vars above) ---
# Api connects as pol_app (RLS-enforced);
# Worker as pol_worker. ASP.NET maps ConnectionStrings__<Name> onto ConnectionStrings:<Name>.
ConnectionStrings__Producer=Server=localhost,11433;Database=VCentralPay;User Id=pol_app;Password=REPLACE_WITH_LOCAL_APP_PASSWORD;Encrypt=True;TrustServerCertificate=True
ConnectionStrings__Worker=Server=localhost,11433;Database=VCentralPay;User Id=pol_worker;Password=REPLACE_WITH_LOCAL_WORKER_PASSWORD;Encrypt=True;TrustServerCertificate=True
ConnectionStrings__Admin=Server=localhost,11433;Database=VCentralPay;User Id=pol_admin;Password=REPLACE_WITH_LOCAL_ADMIN_PASSWORD;Encrypt=True;TrustServerCertificate=True
# Admin = pol_admin (RLS-bypass), used ONLY by tenant provisioning (POST/GET /admin/tenants).
# The API fail-fasts at boot if ConnectionStrings__Admin is unset.

# Design-time connection used by `dotnet ef migrations/database update` (runs DDL -> use sa or a
# dedicated migrator login; the runtime app principals deliberately have NO DDL rights).
POL_DESIGN_SQL=Server=localhost,11433;Database=VCentralPay;User Id=sa;Password=REPLACE_WITH_LOCAL_SA_PASSWORD;Encrypt=True;TrustServerCertificate=True

# --- Vault master key (PLAN #14) ---
# 32-byte AES key, base64. DEV/LOCAL custody ONLY (stands in for the external KMS/HSM). The value
# below is base64 of 32 ZERO bytes (a FAKE key). Generate a real local key with:
#   head -c 32 /dev/urandom | base64
Vault__MasterKeyBase64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Google SSO (PLAN #5) — one API accepts both SPA Google client ids as audiences ---
Google__Audiences__tenant=REPLACE_WITH_TENANT_SPA_GOOGLE_CLIENT_ID.apps.googleusercontent.com
Google__Audiences__admin=REPLACE_WITH_ADMIN_SPA_GOOGLE_CLIENT_ID.apps.googleusercontent.com
