# pol-core — local/dev environment template. Copy to .env and fill LOCAL values only.
# NEVER put a real secret here. .env is gitignored; only this .env.example is committed.
#
# Who actually reads each variable (verified against the tree — nothing here is aspirational):
#   docker-compose.yml     MSSQL_SA_PASSWORD, POL_APP_PASSWORD, POL_HIPPO_APP_PASSWORD,
#                          POL_MAMMOTH_APP_PASSWORD
#   the Api host           ConnectionStrings__*, Vault__*, AdminAuth__*, MerchantAuth__*, AdminAllowlist__*,
#                          AdminSession__*, MerchantSession__*, MerchantUser__Invitation__*, Cors__*,
#                          Merchant__*, Psp__*, Seq__*
#                          SpDocument__* (external-sim-separate-containers)
#   dotnet ef              POL_DESIGN_SQL
#   Integration.Tests      POL_SQL_SERVER, POL_DB, POL_SA_PASSWORD, POL_APP_PASSWORD,
#                          POL_HIPPO_SQL_SERVER, POL_MAMMOTH_SQL_SERVER, POL_HIPPO_APP_PASSWORD,
#                          POL_MAMMOTH_APP_PASSWORD (IntegrationDb.cs)
#
# Compose reads this file on its own; the Api host and dotnet ef do NOT — export first:
#   set -a && source .env && set +a
#
# The Api host's remaining local settings (Cors, Merchant:DevMerchantId, ...) may instead live in the
# gitignored src/Hosts/Api/appsettings.Development.json — see appsettings.Development.json.example. An env
# var here WINS over that file, so set a given key in one place only.

# --- SQL Server 2025 container (docker-compose.yml) ---
MSSQL_SA_PASSWORD=REPLACE_WITH_LOCAL_SA_PASSWORD

# Same sa password under the name the integration suite reads. IntegrationDb.cs requires
# POL_SA_PASSWORD and throws without it.
POL_SA_PASSWORD=REPLACE_WITH_LOCAL_SA_PASSWORD

# --- DB principal passwords — one per DB tier, never shared (sim-db-separate-logins) ---
# Each must be strong and must NOT contain its own login name (SQL Server CHECK_POLICY). Placeholders only.
# pol_app (docker/bootstrap/01-principals.sql) is the sole runtime principal of VCentralPay
# (rls-to-query-filter task 8 collapsed the old 5-principal/RLS apparatus into one app-layer-guarded
# principal shared by every host). The two simulated upstream instances stand in for systems we do NOT
# own, so they get their own logins with their own passwords: hippo_app on hippodb
# (docker/bootstrap/02-hippo-sim.sql) and mammoth_app on mammothdb (03-mammoth-sim.sql). Use three
# DIFFERENT values — sharing one defeats the point.
POL_APP_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
POL_HIPPO_APP_PASSWORD=REPLACE_WITH_LOCAL_HIPPO_PASSWORD
POL_MAMMOTH_APP_PASSWORD=REPLACE_WITH_LOCAL_MAMMOTH_PASSWORD

# --- Target DB (Integration.Tests) ---
# IntegrationDb.cs defaults to exactly these two values, so they only matter when you point elsewhere.
POL_SQL_SERVER=localhost,11433
POL_DB=VCentralPay
POL_HIPPO_SQL_SERVER=localhost,11434
POL_MAMMOTH_SQL_SERVER=localhost,11435

# Every value below that contains a ';', a space or a '$' is SINGLE-QUOTED, and must stay that way.
# Docker Compose parses this file itself and strips the quotes, but the README also has you run
# `set -a && source .env && set +a` — and to a shell an unquoted ';' is a command separator. Without
# the quotes that silently truncates each connection string at the first ';' (POL_DESIGN_SQL becomes
# just `Server=localhost,11433`, and `User Id=sa` gets run as a command), which surfaces much later
# as a confusing pre-login-handshake failure from `dotnet ef`. Single quotes rather than double so a
# '$' in a password is not interpolated either.
#
# --- Runtime connection string (VCentralPay: one principal — pol_app — for every host; password from
# POL_APP_PASSWORD above) ---
# ASP.NET maps ConnectionStrings__<Name> onto ConnectionStrings:<Name>. Required: the host throws at boot
# without it ("ConnectionStrings:App is required").
ConnectionStrings__App='Server=localhost,11433;Database=VCentralPay;User Id=pol_app;Password=REPLACE_WITH_LOCAL_APP_PASSWORD;Encrypt=True;TrustServerCertificate=True'

# Development-only auto-migrate at boot: the host applies pending EF migrations on THIS connection, so it
# needs the DDL rights pol_app deliberately lacks (use sa locally). Unset = skipped with a warning, never a
# crash. Prod migrates out-of-band via docker/migrate-entrypoint.sh, never here.
ConnectionStrings__Migrator='Server=localhost,11433;Database=VCentralPay;User Id=sa;Password=REPLACE_WITH_LOCAL_SA_PASSWORD;Encrypt=True;TrustServerCertificate=True'

# --- Document-search upstream (external-sim-separate-containers) ---
# hippodb/mammothdb each run on their own SQL Server instance now (hippo-db :11434, mammoth-db
# :11435) — no derive/fallback from ConnectionStrings__App anymore (supersedes products-sp-gateway
# REQ-3.4). Each uses its OWN principal and password (hippo_app / mammoth_app, sim-db-separate-logins):
# paste the matching POL_HIPPO_APP_PASSWORD / POL_MAMMOTH_APP_PASSWORD value above, NOT the pol_app one.
# Unset -> host still boots, a products search request gets 503 (REQ-5.7, unchanged).
SpDocument__MotorConnectionString='Server=localhost,11434;Database=hippodb;User Id=hippo_app;Password=REPLACE_WITH_LOCAL_HIPPO_PASSWORD;Encrypt=True;TrustServerCertificate=True'
SpDocument__NonMotorConnectionString='Server=localhost,11435;Database=mammothdb;User Id=mammoth_app;Password=REPLACE_WITH_LOCAL_MAMMOTH_PASSWORD;Encrypt=True;TrustServerCertificate=True'

# Design-time connection used by `dotnet ef migrations/database update` (runs DDL -> use sa or a
# dedicated migrator login; the runtime app principal deliberately has NO DDL rights).
POL_DESIGN_SQL='Server=localhost,11433;Database=VCentralPay;User Id=sa;Password=REPLACE_WITH_LOCAL_SA_PASSWORD;Encrypt=True;TrustServerCertificate=True'

# --- Vault master key (PLAN #14) ---
# 32-byte AES key, base64. DEV/LOCAL custody ONLY (stands in for the external KMS/HSM). The value
# below is base64 of 32 ZERO bytes (a FAKE key). Generate a real local key with:
#   head -c 32 /dev/urandom | base64
# This is the legacy single-key shim; the keyring form is Vault__ActiveKeyId + Vault__Keys__<id>__KeyFile
# (what docker-compose.prod.yml uses). Setting BOTH forms is a boot-time error — pick one.
Vault__MasterKeyBase64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Signed external audit anchor (optional in Development/Testing only) ---
# Point Path at a persistent volume outside SQL. SigningKeyFile contains one non-zero 32-byte base64 key
# (`openssl rand -base64 32`), never the Vault key and never a committed file. Configure both or neither.
# AuditAnchor__Path=/absolute/persistent/audit/anchors.jsonl
# AuditAnchor__SigningKeyFile=/absolute/secret/audit_anchor_signing_key

# --- OIDC BFF providers (multi-provider-oidc) — Google is the primary provider; Microsoft Entra is opt-in
# via the same pattern (AdminAuth__Providers__Microsoft__ClientId / __ClientSecret / __Authority, and
# MerchantAuth__Providers__Microsoft__*). A blank ClientId skips that provider's scheme locally.
AdminAuth__Providers__Google__ClientId=REPLACE_WITH_ADMIN_OIDC_CLIENT_ID.apps.googleusercontent.com
AdminAuth__Providers__Google__ClientSecret=REPLACE_WITH_ADMIN_OIDC_CLIENT_SECRET
MerchantAuth__Providers__Google__ClientId=REPLACE_WITH_MERCHANT_USER_OIDC_CLIENT_ID.apps.googleusercontent.com
MerchantAuth__Providers__Google__ClientSecret=REPLACE_WITH_MERCHANT_USER_OIDC_CLIENT_SECRET

# Microsoft Entra providers are optional. Leave ClientId blank/unset to disable each scheme locally.
# AdminAuth__Providers__Microsoft__Authority=https://login.microsoftonline.com/REPLACE_WITH_TENANT_ID/v2.0
# AdminAuth__Providers__Microsoft__ClientId=REPLACE_WITH_ADMIN_ENTRA_CLIENT_ID
# AdminAuth__Providers__Microsoft__ClientSecret=REPLACE_WITH_ADMIN_ENTRA_CLIENT_SECRET
# AdminAuth__Providers__Microsoft__CallbackPath=/api/v1/admins/auth/microsoft/callback
# MerchantAuth__Providers__Microsoft__Authority=https://REPLACE_WITH_TENANT_NAME.ciamlogin.com/REPLACE_WITH_TENANT_ID/v2.0
# MerchantAuth__Providers__Microsoft__ClientId=REPLACE_WITH_MERCHANT_ENTRA_CLIENT_ID
# MerchantAuth__Providers__Microsoft__ClientSecret=REPLACE_WITH_MERCHANT_ENTRA_CLIENT_SECRET
# MerchantAuth__Providers__Microsoft__CallbackPath=/api/v1/merchants/auth/microsoft/callback

# First-Super bootstrap: the Google `sub` values allowed to self-provision as Super on first login. Empty in
# appsettings.json, so without this nobody can become the first admin. Read the real `sub` from
# admin.AuthAudits after one denied login attempt, set it here, restart.
# AdminAllowlist__Subjects__0=

# Post-login/error redirects are made absolute against each SPA's origin (the IdP callback lands on the API
# origin). Blank in appsettings.json — set these when running the SPAs locally.
# Use the SAME origins as the two Cors entries below.
# AdminSession__WebAppBaseUrl=https://localhost:3001
# AdminSession__ReturnUrlAllowlist__0=/
# AdminSession__ReturnUrlAllowlist__1=/dashboard
# Development-only Scalar return target. Add `/scalar` at the next numeric allowlist index when configuring via env.
# AdminSession__ReturnUrlAllowlist__2=/scalar
# AdminSession__ScalarBaseUrl=https://localhost:5001
# MerchantSession__WebAppBaseUrl=https://localhost:3002
# MerchantSession__ReturnUrlAllowlist__0=/
# MerchantSession__ReturnUrlAllowlist__1=/dashboard
# Forwarded headers are trusted only from deployment proxy CIDR; never use 0.0.0.0/0 or ::/0.
# FORWARDED_HEADERS_KNOWN_NETWORK=172.18.0.0/16
# MERCHANT_INVITATION_SMTP_HOST=smtp.example.test
# MERCHANT_INVITATION_SMTP_PORT=587
# MERCHANT_INVITATION_SMTP_ENABLE_SSL=true
# MERCHANT_INVITATION_SMTP_FROM=no-reply@example.test
# MERCHANT_INVITATION_SMTP_USERNAME=replace-me
# SMTP password belongs in ./secrets/merchant_invitation_smtp_password, never this file.

# Browser SPA origins for the two credentialed CORS policies (dev: admin console 3001, merchant-user console
# 3002 — each proxies /api to the API on 5001, so these are what the browser hits). Customer SPA 3000 also
# proxies /api same-origin and is not granted console-cookie CORS. Empty in appsettings.json
# = no cross-origin allowed. appsettings.Development.json.example sets them too — pick ONE place.
# Cors__MerchantOrigins__0=https://localhost:3002
# Cors__AdminOrigins__0=https://localhost:3001

# Dev-only merchant binding for a request with no merchant in context (HttpActorContext).
# Merchant__DevMerchantId=00000000-0000-0000-0000-000000000001

# --- PSP operational config (non-secret; PSP credentials live in the vault, never here) ---
# UseSandbox defaults true, so an unconfigured local run can only ever hit a PSP sandbox.
Psp__UseSandbox=true
Psp__DefaultCode=2c2p
# This API's public origin. The backend-notification URL handed to a PSP is derived from it PER CONNECTION
# ({Psp:PublicBaseUrl}/api/v1/webhooks/{pspConnectionId}). Blank is tolerated in Development ONLY — outside
# it the host fails fast at boot. A localhost value boots fine but no PSP can call back into it: to exercise
# a real sandbox webhook, put a public tunnel origin here instead.
Psp__PublicBaseUrl=https://localhost:5001
# Where each PSP sends the customer's BROWSER back after the hosted page (UX only, never a status source).
Psp__TwoCTwoP__FrontendReturnUrl=https://localhost:3000/checkout/return
Psp__Omise__ReturnUri=https://localhost:3000/checkout/return

# --- Seq sink for denial/authz telemetry (optional; unset = log-only, never blocks a request) ---
# docker-compose.yml binds Seq to 127.0.0.1:5341. The dispatcher appends /api/events/raw itself.
Seq__IngestionUrl=http://localhost:5341
