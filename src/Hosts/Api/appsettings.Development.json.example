{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "App": "Server=localhost,11433;Database=VCentralPay;User Id=pol_app;Password=REPLACE_WITH_LOCAL_APP_PASSWORD;Encrypt=True;TrustServerCertificate=True"
  },
  "_SpDocument_note": "external-sim-separate-containers: hippodb/mammothdb each run on their own SQL Server instance (hippo-db :11434, mammoth-db :11435) — no derive/fallback from ConnectionStrings:App anymore (supersedes products-sp-gateway REQ-3.4). Each uses its OWN principal and password (hippo_app / mammoth_app, sim-db-separate-logins): paste the matching POL_HIPPO_APP_PASSWORD / POL_MAMMOTH_APP_PASSWORD value from .env, NOT the pol_app one — pol_app does not exist on the sim instances. Unset -> host still boots, products search returns 503 (REQ-5.7).",
  "SpDocument": {
    "MotorConnectionString": "Server=localhost,11434;Database=hippodb;User Id=hippo_app;Password=REPLACE_WITH_LOCAL_HIPPO_PASSWORD;Encrypt=True;TrustServerCertificate=True",
    "NonMotorConnectionString": "Server=localhost,11435;Database=mammothdb;User Id=mammoth_app;Password=REPLACE_WITH_LOCAL_MAMMOTH_PASSWORD;Encrypt=True;TrustServerCertificate=True"
  },
  "Merchant": {
    "DevMerchantId": "00000000-0000-0000-0000-000000000001"
  },
  "AdminSession": {
    "DefaultReturnPath": "/dashboard",
    "ReturnUrlAllowlist": [
      "/",
      "/main",
      "/dashboard",
      "/tenants",
      "/scalar"
    ],
    "SpaBaseUrl": "https://localhost:3001",
    "ScalarBaseUrl": "https://localhost:5001"
  },
  "_MerchantAuth_note": "Merchant-user BFF OIDC client (REQ-8/9/14). The section is 'MerchantAuth' with a Providers map keyed by provider name — multi-provider-oidc renamed it away from the old single-client 'MerchantUser:Oidc' shape, which nothing reads anymore. Leave ClientId blank to keep merchant-user login disabled locally (the scheme is skipped); set both to a real 'Web application' Google client to exercise the live flow. Its registered redirect_uri must be <origin the browser actually hits>/api/v1/merchants/auth/google/callback — the SPA proxy origin, not the API port, whenever the SPA proxies /api. RegisterUrl is deliberately left at its relative default ('/register', made absolute against MerchantUser:Session:SpaBaseUrl at redirect time): a committed absolute localhost value is how a localhost redirect ships to production.",
  "MerchantAuth": {
    "Providers": {
      "Google": {
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },
  "MerchantUser": {
    "Session": {
      "SpaBaseUrl": "https://localhost:3002"
    }
  },
  "Cors": {
    "_note": "Three dev SPAs, two credentialed console CORS policies (BuildingBlocks.Web/CorsExtensions.cs): customer :3000 uses a same-origin /api proxy and PSP browser return; AllowedOrigins = merchant-user console :3002 (default policy); AdminOrigins = admin console :3001 (/api/v1/admins/* only). Each SPA proxies /api to https://localhost:5001; register the origin actually used to start login (the console origin through its proxy, or :5001 for a direct API test).",
    "AllowedOrigins": ["https://localhost:3002"],
    "AdminOrigins": ["https://localhost:3001"]
  },
  "Psp": {
    "PublicBaseUrl": "https://localhost:5001",
    "TwoCTwoP": {
      "FrontendReturnUrl": "https://localhost:3000/checkout/return"
    },
    "Omise": {
      "ReturnUri": "https://localhost:3000/checkout/return"
    }
  },
  "Vault": {
    "MasterKeyBase64": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  }
}
