<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runtime persistence assembly for the ControlPlane cluster (admin.* + iam.* + cfg.* +
       dbo.DataProtectionKeys — rls-to-query-filter design.md "Context topology"). References the Domain
       projects of its cluster's modules + BuildingBlocks.Infrastructure (SchemaNames + the framework-owned
       DataProtectionKey type), AND each cluster module's Application project (to implement their ports —
       IUserRepository/IRoleRepository/IMasterDataLookup etc., task 8.5.1) — never a module's Infrastructure
       project, so this assembly still carries none of the old single-context repositories. -->

  <!-- FrameworkReference (not Sdk.Web) gives the ASP.NET Core Data Protection APIs (IXmlRepository) without
       making this a web app — same pattern as BuildingBlocks.Web. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Admins\Admins.Domain\Admins.Domain.csproj" />
    <ProjectReference Include="..\..\Modules\Iam\Iam.Domain\Iam.Domain.csproj" />
    <ProjectReference Include="..\..\Modules\MasterData\MasterData.Domain\MasterData.Domain.csproj" />
    <ProjectReference Include="..\..\Modules\Admins\Admins.Application\Admins.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Iam\Iam.Application\Iam.Application.csproj" />
    <ProjectReference Include="..\..\Modules\MasterData\MasterData.Application\MasterData.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- internal sealed context: no production code outside this assembly may construct it (REQ-11.8).
       Architecture.Tests needs InternalsVisibleTo to build the model-disjointness/seal-reflection guardrail
       tests — the same pattern BuildingBlocks.Web/Api already use for Hosts.Tests. Persistence.Provisioning
       (task 7) is the ONE narrow, design-sanctioned exception (R3-v7 #4): the provisioning coordinator binds
       this context to a shared connection/transaction alongside MerchantRuntimeDbContext. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Architecture.Tests" />
    <InternalsVisibleTo Include="Persistence.Provisioning" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
