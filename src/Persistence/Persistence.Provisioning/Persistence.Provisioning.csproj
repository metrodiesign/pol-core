<Project Sdk="Microsoft.NET.Sdk">

  <!-- rls-to-query-filter task 7 (design.md "Provisioning UoW"): the dedicated provisioning-integration
       assembly — the ONLY place in the codebase two runtime contexts share a transaction. References BOTH
       Persistence.ControlPlane and Persistence.MerchantRuntime (needs InternalsVisibleTo from both, granted
       narrowly in their own csproj — R3-v7 #4) plus BuildingBlocks (the port contract + vault crypto
       primitives). NEVER referenced by a module's Application/Infrastructure project directly; only the Api
       host composition root wires IProvisioningWriter to the internal coordinator here. -->

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\Persistence.ControlPlane\Persistence.ControlPlane.csproj" />
    <ProjectReference Include="..\Persistence.MerchantRuntime\Persistence.MerchantRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <!-- internal coordinator: no production code outside this assembly may construct it (design.md "NOT a
       public coordinator"). Architecture.Tests needs InternalsVisibleTo to test it directly, same pattern as
       every other Persistence.* project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Architecture.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
