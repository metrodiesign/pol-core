{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/king_developer/Desktop/Project/pol-core/.codex/hooks/destructive-guard.sh'"
          },
          {
            "type": "command",
            "command": "'/Users/king_developer/Desktop/Project/pol-core/.codex/hooks/hook-bypass-guard.sh'"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/king_developer/Desktop/Project/pol-core/.codex/hooks/spec-edit-guard.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/king_developer/Desktop/Project/pol-core/.codex/hooks/task-gate.sh'",
            "timeout": 120
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/king_developer/Desktop/Project/pol-core/.codex/hooks/precompact-persist.sh'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --arg b \"$(git branch --show-current 2>/dev/null)\" --arg s \"$(ls .ai/specs 2>/dev/null | tr '\\n' ' ')\" '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:(\"Branch: \"+$b+\". Active specs: \"+$s)}}'"
          }
        ]
      }
    ]
  }
}
