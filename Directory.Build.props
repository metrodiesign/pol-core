<Project>

  <!-- Solution-wide build knobs. Stack pins live in Directory.Packages.props. -->
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Must stay false: Microsoft.Data.SqlClient does not support globalization-invariant mode and
         throws "Globalization Invariant Mode is not supported" the moment it opens a SQL Server
         connection. Unit tests use Sqlite (invariant-safe) so this only surfaces against real SQL. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Scriban 6.2.0 transitive-vuln suppression (spike 2026-06-21, CODING_STANDARDS.md).
       Scriban enters ONLY via Mediator.SourceGenerator 3.0.1 — a build/design-time analyzer
       with PrivateAssets=all that is NOT shipped to runtime output. Runtime exposure: none.
       Policy: suppress per-advisory with reason; do NOT force-downgrade the source generator.
       Re-review and prune this list whenever Mediator updates its Scriban pin. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-24c8-4792-22hx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5rpf-x9jg-8j5p" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5wr9-m6jw-xx44" />
    <!-- GHSA-7jvp-hj45-2f2m: TypedObjectAccessor mass-assignment / access-modifier bypass (patched
         Scriban 7.2.2). Runtime-facing ONLY when templates render live host objects at runtime — N/A
         here: Scriban runs build-time inside the source generator, never in Host runtime output. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7jvp-hj45-2f2m" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-c875-h985-hvrc" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-grr9-747v-xvcp" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-m2p3-hwv5-xpqw" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-p6q4-fgr8-vx4p" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q6rr-fm2g-g5x8" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v66j-x4hw-fv9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wgh7-7m3c-fx25" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-x6m9-38vm-2xhf" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xcx6-vp38-8hr5" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xw6w-9jjh-p9cr" />
  </ItemGroup>

  <!-- SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11 transitive-vuln suppression
       (GHSA-2m69-gcr7-jv3q, high severity, no patched release available as of 2026-06-21).
       Enters ONLY via Microsoft.EntityFrameworkCore.Sqlite, which is referenced ONLY by the
       BuildingBlocks.Tests in-memory Sqlite test harness (ProducerDbContextTestHarness) —
       test-only, never in any Host runtime output, never network-exposed. Runtime exposure: none.
       Policy: suppress per-advisory with reason. Re-review and remove once SQLitePCLRaw ships a
       fixed release (SQLite >= 3.50.2) and EF Core's Sqlite provider picks it up. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- rls-to-query-filter REQ-11.8 / design.md "Assembly split + Api host boundary": ControlPlaneDbContext
       is the ONE runtime context merchant-TENANT code must never be able to name. A forbidden ProjectReference
       to Persistence.ControlPlane fails the build immediately for every project outside this allowlist —
       compile-time, not just an arch-lint test. Widen the allowlist only for a project that legitimately
       needs both control-plane and merchant persistence in one assembly (e.g. the provisioning-integration
       assembly design.md §"Provisioning-integration assembly" calls for, task 7) — never for convenience.
       Api is in the allowlist (task 8.5.7, "1 principal"): it is the composition root serving BOTH the admin
       console and the merchant-user console, so it wires AddControlPlanePersistence/AddMerchantUserPersistence/
       AddMerchantRuntimePersistence itself — this only exposes the PUBLIC ports each registration extension
       declares (IMerchantRoleReader, IAdminRoleAssignmentCountReader, IPersistedXmlRepository, ...), never the
       internal ControlPlaneDbContext type itself (still inaccessible — no InternalsVisibleTo(Api) exists).
       The guard still blocks every module's own Infrastructure project (Products/Carts/Orders/
       Payments/Merchants) from referencing Persistence.ControlPlane, which is the actual REQ-11.8 concern.
       Hosts.Tests is in the allowlist for the same reason as Api: it tests Api's composition root directly
       (extern alias ApiHost) and needs the same public ports (e.g. IAdminRoleAssignmentCountReader) to build
       fakes/compose the classes it tests — never the internal ControlPlaneDbContext itself.
       Runs BeforeTargets="Build" so `dotnet build`/`dotnet test` on the whole solution enforces it, not only
       a dedicated arch-lint test run. -->
  <PropertyGroup>
    <_ControlPlaneReferenceAllowlist>;Persistence.ControlPlane;Architecture.Tests;Persistence.Provisioning;Api;Hosts.Tests;</_ControlPlaneReferenceAllowlist>
  </PropertyGroup>

  <Target Name="RlsToQueryFilter_EnforcePersistenceBoundaries" BeforeTargets="Build">
    <ItemGroup>
      <_ForbiddenControlPlaneRef Include="@(ProjectReference)" Condition="'%(Filename)' == 'Persistence.ControlPlane'" />
    </ItemGroup>
    <Error
      Condition="'@(_ForbiddenControlPlaneRef)' != '' AND !$(_ControlPlaneReferenceAllowlist.Contains(';$(MSBuildProjectName);'))"
      Text="Forbidden ProjectReference: '$(MSBuildProjectName)' may not reference Persistence.ControlPlane (compile-time control-plane isolation boundary, rls-to-query-filter REQ-11.8). Allowed: $(_ControlPlaneReferenceAllowlist)" />
  </Target>

</Project>
