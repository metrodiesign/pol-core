#!/usr/bin/env bash
# pre-commit — Tier 1 enforcement floor (covers EVERY agent + human).
# Enabled per-clone with: git config core.hooksPath .githooks  (see .ai/README.md SETUP)
#
# Runs two fast, deterministic gates. NO tests here (they belong in CI, ci.yml) —
# pre-commit must stay quick so it does not tempt anyone into --no-verify.
#   1. Secret scan of the staged change (single source: .ai/bin/check-secrets.sh).
#   2. If any */tasks.md is staged, require an Evidence: block in the staged content
#      (presence check only — the real typecheck+test gate runs in CI / task-gate).
# Any non-zero exit blocks the commit.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
BIN="$REPO_ROOT/.ai/bin"

# 1. Secret scan (staged diff). check-secrets.sh exits non-zero when a secret is found.
"$BIN/check-secrets.sh"

# 2. Per-task Evidence gate for staged tasks.md files (Task 3 semantics).
#    Raw transport ONLY here: this hook builds the full HEAD/index snapshot pair,
#    gets canonical ranges from `spec_contract.py diff-ranges`, and lets the
#    shared engine discover newly-completed tasks and validate Evidence v2.
#    No checkbox grep, no Evidence parsing in shell — those moved into the engine.
STAGED_TASKS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)tasks\.md$' || true)
if [ -n "$STAGED_TASKS" ]; then
  SNAP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sdd-precommit.XXXXXX")"
  trap 'rm -rf "$SNAP_DIR"' EXIT
  i=0
  for f in $STAGED_TASKS; do
    i=$((i + 1))
    AFTER_BLOB="$SNAP_DIR/after-$i"
    BEFORE_FLAG="-"
    if git cat-file -e "HEAD:$f" 2>/dev/null; then
      BEFORE_FLAG="$SNAP_DIR/before-$i"
      git cat-file blob "HEAD:$f" >"$BEFORE_FLAG"
    fi
    git show ":$f" >"$AFTER_BLOB"

    RANGES_JSON="$SNAP_DIR/ranges-$i.json"
    : >"$SNAP_DIR/empty-base"
    if [ "$BEFORE_FLAG" = "-" ]; then
      python3 "$REPO_ROOT/scripts/spec_contract.py" diff-ranges \
        --before-file "$SNAP_DIR/empty-base" --after-file "$AFTER_BLOB" >"$RANGES_JSON" \
        || { echo "ENGINE_INTERNAL: diff-ranges failed for $f" >&2; exit 1; }
    else
      python3 "$REPO_ROOT/scripts/spec_contract.py" diff-ranges \
        --before-file "$BEFORE_FLAG" --after-file "$AFTER_BLOB" >"$RANGES_JSON" \
        || { echo "ENGINE_INTERNAL: diff-ranges failed for $f" >&2; exit 1; }
    fi

    ENVELOPE="$(bash "$BIN/check-evidence.sh" "$f" "$BEFORE_FLAG" "$AFTER_BLOB" "$RANGES_JSON" pre-commit)"
    EV_RC=$?
    printf '%s\n' "$ENVELOPE" >&2
    if [ "$EV_RC" -ne 0 ]; then
      echo "Blocked: staged tasks.md '$f' failed the Evidence v2 gate." >&2
      echo "Fix the diagnostics above (test result + viewports 375/768/1440 or n/a + deviations) and restage." >&2
      exit 1
    fi
  done
fi

exit 0
