# Self-host production config for docker-compose.prod.yml. Copy to `.env` and fill in.
# This file holds NON-secret config + the bootstrap-only SA password. The long-lived app credentials
# (DB principal passwords, vault master key, DB CA cert) are FILE secrets under ./secrets/ — NOT here.
# `.env` is gitignored; never commit a filled-in copy.

# --- SQL Server (bootstrap-only SA password on the DB tier; rotate after first migrate, app never uses sa) ---
# Must meet SQL Server SA complexity (>=8 chars, 3 of upper/lower/digit/symbol). Avoid ; " ' (breaks the
# connection string). Generate e.g.: openssl rand -base64 24 | tr -d '/+=' | head -c 28
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD

# --- Database (DB tier is a separate, infra/DBA-provisioned host — see docs/runbooks/deploy-self-host.md) ---
DB_SERVER=REPLACE_WITH_DB_TIER_HOSTNAME_OR_IP
DB_PORT=1433
DB_NAME=VCentralPay
# Path to the mounted CA/server cert secret (pins Encrypt=Strict TLS validation) — set to
# /run/secrets/db_ca_cert to enable pinning (and drop the real cert at ./secrets/db_ca_cert). Leave blank if
# the DB tier's cert already chains to a public CA (falls back to Encrypt=True;TrustServerCertificate=False —
# no env var can override that to True).
DB_CA_CERTIFICATE_FILE=

# --- Sim DB tiers (external-sim-separate-containers) — hippodb/mammothdb each run on their own,
# infra/DBA-provisioned host, same shape as the DB tier above (both required: `migrate`/`api` fail fast
# at compose-render time when either server is unset). sa password is shared with MSSQL_SA_PASSWORD
# above (bootstrap-only, same as the main DB tier). Both tiers' certs must chain to the SAME
# db_ca_cert secret file as the main DB tier above — there is only one CA pin for the whole deploy;
# if the main DB tier's cert already chains to a public CA (DB_CA_CERTIFICATE_FILE left blank), these
# two tiers must too.
# The APP PRINCIPAL is NOT shared, though (sim-db-separate-logins): hippodb runs on `hippo_app` and
# mammothdb on `mammoth_app`, each with its own password in its own file secret —
# ./secrets/hippo_app_password and ./secrets/mammoth_app_password (create them alongside
# ./secrets/pol_app_password, see docs/runbooks/deploy-self-host.md). pol_app never reaches these tiers.
HIPPO_DB_SERVER=REPLACE_WITH_HIPPO_DB_TIER_HOSTNAME_OR_IP
HIPPO_DB_PORT=1433
MAMMOTH_DB_SERVER=REPLACE_WITH_MAMMOTH_DB_TIER_HOSTNAME_OR_IP
MAMMOTH_DB_PORT=1433

# --- API port (left side = published on the Docker host; front it with a TLS reverse proxy) ---
# Published API port on the Docker host (HTTPS 5101 = TLS reverse proxy in front, see runbook).
API_PORT=5100

# Audit anchors are written to a dedicated persistent volume configured in docker-compose.prod.yml.
# Create ./secrets/audit_anchor_signing_key with `openssl rand -base64 32`; never reuse the Vault key.

# --- Google SSO (both SPAs are server-side OIDC BFFs; each client SECRET is a file secret under ./secrets/) ---
MERCHANT_USER_OIDC_CLIENT_ID=REPLACE_WITH_MERCHANT_USER_OIDC_CLIENT_ID.apps.googleusercontent.com
ADMIN_OIDC_CLIENT_ID=REPLACE_WITH_ADMIN_OIDC_CLIENT_ID.apps.googleusercontent.com

# --- Microsoft Entra ID (opt-in; leave ALL blank to keep Microsoft login off) ---
# Every value is env-injected — nothing is committed in appsettings/compose. Enabling a plane requires BOTH
# its client id and its authority; the authority MUST be a tenant-pinned v2.0 endpoint (multi-tenant
# common/organizations/consumers is rejected at boot). Client secrets go in the admin_entra_client_secret /
# merchant_entra_client_secret file secrets, never here.
# Admin (workforce), e.g. ADMIN_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
ADMIN_ENTRA_CLIENT_ID=
ADMIN_ENTRA_AUTHORITY=
# Merchant-user (Entra External ID / CIAM), e.g.
# MERCHANT_ENTRA_AUTHORITY=https://<name>.ciamlogin.com/<tenant-id>/v2.0 — always the /v2.0 tenant-id form,
# not the /<name>.onmicrosoft.com domain form (that resolves v1 metadata and issuer validation will fail).
MERCHANT_ENTRA_CLIENT_ID=
MERCHANT_ENTRA_AUTHORITY=

# --- Browser SPA frontend origins (CORS allowlist; scheme + host + port, no trailing slash) ---
# The two separate Next.js SPAs (pol-tenant, pol-admin) that call this API. Required: unset => API won't start.
MERCHANT_USER_FRONTEND_ORIGIN=https://app.example.com
ADMIN_FRONTEND_ORIGIN=https://admin.example.com

# --- Trusted reverse proxy ---
# Narrow CIDR of the network containing the TLS reverse proxy. Never use a wildcard.
FORWARDED_HEADERS_KNOWN_NETWORK=172.18.0.0/16

# --- Merchant invitation email ---
# Password belongs in ./secrets/merchant_invitation_smtp_password, never this file.
MERCHANT_INVITATION_SMTP_HOST=smtp.example.com
MERCHANT_INVITATION_SMTP_PORT=587
MERCHANT_INVITATION_SMTP_ENABLE_SSL=true
MERCHANT_INVITATION_SMTP_FROM=no-reply@example.com
MERCHANT_INVITATION_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME

# --- PSP operational config (non-secret; PSP keys live in the vault, never here) ---
# PSP_PUBLIC_BASE_URL = this API's public origin. The backend-notification URL handed to a PSP is derived
# from it PER CONNECTION (/api/v1/webhooks/{pspConnectionId}), which replaced the old single global
# PSP_TWOCTWOP_BACKEND_RETURN_URL (correct for at most one connection). Required: blank or non-absolute
# => API won't start outside Development. Omise takes its webhook endpoint from the Omise dashboard
# instead, per connection - see docs/runbooks/deploy-self-host.md.
PSP_USE_SANDBOX=true
PSP_PUBLIC_BASE_URL=https://api.example.com
# Where each PSP sends the customer's BROWSER back after the hosted page (a page on the merchant SPA;
# UX only, never a status source).
PSP_TWOCTWOP_FRONTEND_RETURN_URL=REPLACE_WITH_CHECKOUT_RETURN_URL
PSP_OMISE_RETURN_URI=REPLACE_WITH_OMISE_RETURN_URI

# --- Seq telemetry sink (docker-compose.prod.yml pins ${SEQ_INGESTION_URL:-http://seq:80}, so under this
# compose file the sink is ALWAYS on — leaving this unset/blank does NOT disable it) ---
# The ILogger fallback (SecurityTelemetryRegistration.cs:27, when Seq:IngestionUrl resolves empty) only
# applies to deploys that do not use this compose file. Override the value to point at another Seq.
SEQ_INGESTION_URL=http://seq:80

# --- docker-compose.registry.yml (pull prebuilt images instead of building locally) ---
# That overlay references ${REGISTRY_IMAGE:?} and ${IMAGE_TAG:?}. Do NOT set them here: GitLab CI injects
# them automatically (REGISTRY_IMAGE=$CI_REGISTRY_IMAGE, IMAGE_TAG=${CI_COMMIT_TAG:-$CI_COMMIT_SHORT_SHA}).
# Set them ONLY when running the overlay by hand, e.g.:
#   REGISTRY_IMAGE=registry.example.com/pol-core IMAGE_TAG=v1.2.3 \
#     docker compose -f docker-compose.prod.yml -f docker-compose.registry.yml up -d
