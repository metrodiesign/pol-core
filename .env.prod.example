# Self-host production config for docker-compose.prod.yml. Copy to `.env` and fill in.
# This file holds NON-secret config + the bootstrap-only SA password. The long-lived app credentials
# (DB principal passwords, vault master key) are FILE secrets under ./secrets/ — NOT here.
# `.env` is gitignored; never commit a filled-in copy.

# --- SQL Server (bootstrap-only SA password; rotate after first migrate, app never uses sa) ---
# Must meet SQL Server SA complexity (>=8 chars, 3 of upper/lower/digit/symbol). Avoid ; " ' (breaks the
# health-cmd / connection string). Generate e.g.: openssl rand -base64 24 | tr -d '/+=' | head -c 28
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD
MSSQL_PID=Developer

# --- Database ---
DB_NAME=PaymentOrchestration

# --- API port (left side = published on the Docker host; front it with a TLS reverse proxy) ---
# Published API port on the Docker host (HTTPS 5101 = TLS reverse proxy in front, see runbook).
API_PORT=5100

# --- Google SSO (the single API accepts BOTH SPAs' OAuth client ids as valid audiences; no secret, JWKS-validated) ---
TENANT_GOOGLE_CLIENT_ID=331131366252-i3josthnem9ptdivmm45io0ur7h8rck5.apps.googleusercontent.com
ADMIN_OIDC_CLIENT_ID=888188325996-569qi5ta7d45p1fqik1li4p33pv9nc1l.apps.googleusercontent.com

# --- Browser SPA frontend origins (CORS allowlist; scheme + host + port, no trailing slash) ---
# The two separate Next.js SPAs (pol-tenant, pol-admin) that call this API. Required: unset => API won't start.
TENANT_FRONTEND_ORIGIN=https://app.example.com
ADMIN_FRONTEND_ORIGIN=https://admin.example.com
