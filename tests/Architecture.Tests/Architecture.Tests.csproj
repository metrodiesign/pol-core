  <!-- Fixtures/ForbiddenControlPlaneReference/Bad.csproj is a standalone project built directly by
       CompileNegativeReferenceTests (a nested `dotnet build`, not a ProjectReference) — its own bin/obj
       output sits inside THIS project's directory tree, outside the default SDK exclude (which only covers
       Architecture.Tests' OWN bin/obj), so its generated AssemblyInfo.cs would otherwise double-compile
       into this assembly (duplicate assembly-attribute errors) once Bad.csproj has been built once. -->
  <ItemGroup>
    <Compile Remove="Fixtures/**/bin/**" />
    <Compile Remove="Fixtures/**/obj/**" />
