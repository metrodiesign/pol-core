<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- References the infrastructure project for Microsoft.Data.SqlClient (transitive via EF SqlServer);
       the tests drive raw connections so they can control SESSION_CONTEXT and impersonation directly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <!-- Iam.Domain: the single central permission/role vocabulary (Keys, Role anchors) — the code side of the
         seed code<->DB parity drift guard (rf2 replaced the two per-side catalogs with this one). -->
    <ProjectReference Include="..\..\src\Modules\Iam\Iam.Domain\Iam.Domain.csproj" />
    <!-- products-sp-gateway task 5: SpDocumentGateway is exercised as the real adapter against the
         simulated upstream, so the test drives the production type rather than a copy of it. -->
    <ProjectReference Include="..\..\src\Modules\Products\Products.Infrastructure\Products.Infrastructure.csproj" />
  </ItemGroup>

</Project>
