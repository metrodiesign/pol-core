**/obj/
**/.vs/
**/TestResults/
.git/
.github/
secrets/
.env
.env.*
!.env.example
!.env.prod.example
*.key
**/appsettings.Development.json
**/appsettings.*.Local.json
docs/
.ai/
.claude/
.workflows/
