# Personal, per-project overrides — never commit
CLAUDE.local.md
.claude/settings.local.json
.workflows/

# OS noise
.DS_Store

# .NET build output
bin/
obj/
# env-specific app config holds dev/real values — commit only the *.json.example template
# (the secret guard forbids committing appsettings.<Environment>.json)
appsettings.*.json
*.user
[Bb]in/
[Oo]bj/
.vs/
*.binlog
TestResults/

# Dependencies / build
node_modules/
dist/
build/
__pycache__/
*.pyc
.next/
next-env.d.ts
coverage/
tsconfig.tsbuildinfo
.playwright-mcp/
.env
.env.*
!.env.example
!.env.prod.example

# Vault master-key secret files — injected as mounted secrets at deploy, NEVER committed
# (see docs/runbooks/vault-key-rotation.md). The keyring reads these via Vault:Keys:<id>:KeyFile.
*.key
secrets/

# DB tier CA cert — dropped here by the operator before building the `migrate` image
# (see Dockerfile's migrate stage), never committed.
docker/db-ca-cert/*.crt
